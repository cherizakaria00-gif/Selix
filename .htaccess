# Toutes les requêtes passent par index.php ; le code, la config et les dépendances ne sont jamais servis.
Options -Indexes
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteRule ^(src|vendor|data)(/|$) - [F,L]
RewriteRule ^(config|config\.example|config\.env)\.php$ - [F,L]
RewriteRule ^(composer\.(json|lock)|README\.md|Dockerfile|\.gitignore|\.dockerignore)$ - [F,L]
# Aucun script ne s'exécute parmi les photos, même si uploads/ est un volume monté.
RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pl|py|cgi|sh)$ - [F,L]
RewriteCond %{REQUEST_URI} !/uploads/
RewriteRule ^ index.php [QSA,L]
